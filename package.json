{
  "name": "eyeland",
  "version": "1.0.0",
  "description": "Eyeland - The living desktop bezel companion and assistant",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "vite": "vite",
    "electron": "electron .",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "dist:portable": "vite build && electron-builder --win portable",
    "dist:installer": "vite build && electron-builder --win nsis",
    "dist:publish": "vite build && electron-builder --win nsis --publish always",
    "website": "npx serve website"
  },
  "build": {
    "appId": "com.eyeland.desktop",
    "productName": "Eyeland",
    "copyright": "Copyright © 2026 Eyeland",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/*.exe",
      "electron/*.ps1",
      "electron/*.cs"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eyeland",
      "artifactName": "Eyeland-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Eyeland-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Avirup-prog",
        "repo": "Eyeland"
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
